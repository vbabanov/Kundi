# Telegram secrets (required for live send)
KUNDI_TYPED_V2_TELEGRAM_BOT_TOKEN=<set-me>
KUNDI_TYPED_V2_TELEGRAM_CHAT_ID=<set-me>

# Monitoring loop runtime config (optional overrides)
KUNDI_TYPED_V2_MONITOR_WORKSPACE=/root/kundi-prod/shared/ops/typed-v2
KUNDI_TYPED_V2_MONITOR_UNIT=kundi-prod-api.service
KUNDI_TYPED_V2_MONITOR_SINCE="1 hour ago"
KUNDI_TYPED_V2_MONITOR_OUTPUT_JSON=/root/kundi-prod/shared/ops/typed-v2/reports/typed_v2_backend_monitoring_snapshot.json
KUNDI_TYPED_V2_MONITOR_OUTPUT_MD=/root/kundi-prod/shared/ops/typed-v2/reports/typed_v2_backend_monitoring_snapshot.md
