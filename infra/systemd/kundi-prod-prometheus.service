[Unit]
Description=Kundi production Assistant Prometheus
After=network-online.target kundi-prod-api.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=kundi-prod-prometheus
ExecStart=/opt/kundi/prometheus/prometheus \
  --config.file=/etc/kundi/prometheus/assistant-prometheus.yml \
  --storage.tsdb.path=/var/lib/kundi-prod-prometheus \
  --storage.tsdb.retention.time=30d \
  --storage.tsdb.retention.size=1GB \
  --web.listen-address=127.0.0.1:29091
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
