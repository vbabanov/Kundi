APP_NAME=kundi-backend
APP_ENV=dev
APP_PORT=8080
LOG_LEVEL=info
HTTP_READ_TIMEOUT_SEC=15
HTTP_WRITE_TIMEOUT_SEC=30

DATABASE_URL=postgres://kundi:kundi@localhost:5432/kundi?sslmode=disable
DB_AUTO_MIGRATE=true

ACCESS_TOKEN_SECRET=replace-with-long-random-secret
ACCESS_TOKEN_TTL_MIN=20
REFRESH_TOKEN_TTL_HOURS=720
FIELD_ENCRYPTION_KEY=replace_with_exactly_32_bytes_key

OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=kundi-dev
OBJECT_STORAGE_ACCESS_KEY=kundi
OBJECT_STORAGE_SECRET_KEY=kundi123
OBJECT_STORAGE_PUBLIC_BASE_URL=http://localhost:9000/kundi-dev

AI_WORKER_CONCURRENCY=4
KUNDI_ASSISTANT_ENABLED=false
KUNDI_VOICE_INPUT_ENABLED=false
ALEM_BASE_URL=https://llm.alem.ai/v1
# Legacy shared key. Keep empty when separate keys are configured.
ALEM_API_KEY=
ALEM_PRIMARY_API_KEY=
ALEM_FALLBACK_API_KEY=
ALEM_PRIMARY_MODEL=
ALEM_FALLBACK_MODEL=
AI_ASSISTANT_LLM_TIMEOUT_SEC=12
AI_ASSISTANT_PRIMARY_TIMEOUT_SEC=10
AI_ASSISTANT_FALLBACK_TIMEOUT_SEC=8
AI_ASSISTANT_HOMEWORK_OVERDUE_DAYS=21
AI_ASSISTANT_HOMEWORK_UPCOMING_DAYS=30
AI_ASSISTANT_HOMEWORK_UNDATED_DAYS=21
AI_ASSISTANT_ACADEMIC_RESULT_DAYS=120
AI_LLM_PROVIDER=deterministic
AI_LLM_BASE_URL=
AI_LLM_API_KEY=
AI_TTS_PROVIDER=deterministic
AI_TTS_BASE_URL=https://cdn.kundi.local
AI_TTS_API_KEY=

WHATSAPP_WORKER_CONCURRENCY=2
WHATSAPP_PROVIDER=deterministic
WHATSAPP_BASE_URL=
WHATSAPP_API_TOKEN=

JOBS_LEASE_SEC=45
JOBS_POLL_MS=800
