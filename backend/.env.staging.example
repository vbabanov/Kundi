APP_NAME=kundi-backend
APP_ENV=staging
APP_PORT=8080
LOG_LEVEL=info
HTTP_READ_TIMEOUT_SEC=20
HTTP_WRITE_TIMEOUT_SEC=40

DATABASE_URL=postgres://kundi:${POSTGRES_PASSWORD}@postgres:5432/kundi?sslmode=disable
DB_AUTO_MIGRATE=false

ACCESS_TOKEN_SECRET=staging_replace_with_long_random_secret
ACCESS_TOKEN_TTL_MIN=20
REFRESH_TOKEN_TTL_HOURS=720
FIELD_ENCRYPTION_KEY=staging_replace_with_exactly_32_bytes

OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=kundi-staging
OBJECT_STORAGE_ACCESS_KEY=${MINIO_ROOT_USER}
OBJECT_STORAGE_SECRET_KEY=${MINIO_ROOT_PASSWORD}
OBJECT_STORAGE_PUBLIC_BASE_URL=

AI_WORKER_CONCURRENCY=4
KUNDI_ASSISTANT_ENABLED=false
KUNDI_ASSISTANT_ROLLOUT_MODE=allowlist
KUNDI_ASSISTANT_CANARY_STUDENT_IDS=
KUNDI_VOICE_INPUT_ENABLED=false
ALEM_BASE_URL=https://llm.alem.ai/v1
# Legacy shared key for compatibility; Assistant canary readiness requires ALEM_PRIMARY_API_KEY.
ALEM_API_KEY=
ALEM_PRIMARY_API_KEY=
ALEM_PRIMARY_MODEL=gemma4
# Initial canary is primary-only. Configure both fallback values together only after a new evaluation.
# ALEM_FALLBACK_API_KEY=
# ALEM_FALLBACK_MODEL=
AI_ASSISTANT_LLM_TIMEOUT_SEC=28
AI_ASSISTANT_PRIMARY_TIMEOUT_SEC=25
AI_ASSISTANT_FALLBACK_TIMEOUT_SEC=8
AI_ASSISTANT_HOMEWORK_OVERDUE_DAYS=21
AI_ASSISTANT_HOMEWORK_UPCOMING_DAYS=30
AI_ASSISTANT_HOMEWORK_UNDATED_DAYS=21
AI_ASSISTANT_ACADEMIC_RESULT_DAYS=120
AI_LLM_PROVIDER=http
AI_LLM_BASE_URL=https://llm-provider.example/v1
AI_LLM_API_KEY=staging_llm_api_key
AI_TTS_PROVIDER=http
AI_TTS_BASE_URL=https://tts-provider.example/v1
AI_TTS_API_KEY=staging_tts_api_key

WHATSAPP_WORKER_CONCURRENCY=2
WHATSAPP_PROVIDER=http
WHATSAPP_BASE_URL=https://whatsapp-provider.example/v1
WHATSAPP_API_TOKEN=staging_whatsapp_api_token

JOBS_LEASE_SEC=45
JOBS_POLL_MS=800
